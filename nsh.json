{
  "name": "香篆",
  "id": "com.iwangjie.xiangzhuan",
  "version": "1.3.4",
  "build": 12,
  "icon": "assets/icon.png",
  "appearance": "light",
  "theme": "theme.json",
  "window": {
    "title": "香篆",
    "defaultSize": {
      "width": 360,
      "height": 520
    },
    "minSize": {
      "width": 340,
      "height": 420
    },
    "defaultPosition": "center",
    "titleBar": {
      "style": "hidden",
      "height": 0
    }
  },
  "macos": {
    "activationPolicy": "accessory",
    "infoPlist": {
      "NSHumanReadableCopyright": "© 2026 wangjie"
    }
  },
  "capabilities": {
    "process": {
      "execute": [
        "/usr/bin/id",
        "/bin/launchctl"
      ]
    },
    "fs": {
      "read": [
        "${homeDir}/Library/LaunchAgents",
        "${homeDir}/Library/Application Support/com.iwangjie.xiangzhuan/input-activity",
        "/Applications/香篆.app"
      ],
      "write": [
        "${homeDir}/Library/LaunchAgents"
      ]
    },
    "application": true,
    "homeDir": true,
    "statusBar": true,
    "windows": true,
    "webview": {
      "hosts": []
    }
  },
  "updater": {
    "github": "iwangjie/xiangzhuan",
    "publicKey": "XbNX97x/269QqRR1EKZnfmun31HLjmjdNvqq/fEaHoo=",
    "packages": {
      "roots": [
        "H3WKq5pS+ujzF63+WEWz4sDpELowUBJwOEfr2OXuOaw="
      ]
    }
  }
}
